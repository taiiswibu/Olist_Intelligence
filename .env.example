# Automatically copied to .env by setup; keep .env private.
APP_TOKEN=CHANGE_ME_LOCAL_TOKEN
API_URL=http://127.0.0.1:8000
# Empty DATABASE_URL uses data/processed/olist.db (SQLite).
DATABASE_URL=

# Ordered fallback. Empty = no LLM calls; UI clearly labels local rules/excerpts.
# Example after configuring keys AND models: groq,gemini,openrouter,nvidia,amd,ollama
LLM_PROVIDERS=
GROQ_API_KEY=
GROQ_MODEL=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GEMINI_API_KEY=
GEMINI_MODEL=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
NVIDIA_API_KEY=
NVIDIA_MODEL=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# AMD service not identified: supply YOUR documented OpenAI-compatible endpoint.
AMD_API_KEY=
AMD_MODEL=
AMD_BASE_URL=
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:4b
# Optional hybrid retrieval: pull an embedding model and run manage.py embed.
RAG_MODE=lexical
EMBED_MODEL=

ODOO_URL=http://127.0.0.1:8069
ODOO_DB=olist_demo
ODOO_LOGIN=admin
ODOO_PASSWORD=
# Generated locally with python scripts/configure_odoo_ai.py; never put the real value in Git.
ODOO_AI_BRIDGE_TOKEN=
# Docker local demo only; change before use outside this local exercise.
ODOO_PG_PASSWORD=olist_local_demo
ANALYTICS_PG_PASSWORD=olist_local_demo
