<odoo>
    <record id="advice_company_rule" model="ir.rule"><field name="name">Gợi ý: công ty được phép</field><field name="model_id" ref="model_olist_ai_product_advice"/><field name="domain_force">[('company_id', 'in', company_ids)]</field></record>
    <record id="advice_staff_rule" model="ir.rule"><field name="name">Gợi ý: người lập</field><field name="model_id" ref="model_olist_ai_product_advice"/><field name="groups" eval="[(4, ref('sales_team.group_sale_salesman'))]"/><field name="domain_force">[('owner_id', '=', user.id)]</field></record>
    <record id="advice_manager_rule" model="ir.rule"><field name="name">Gợi ý: quản lý nhóm</field><field name="model_id" ref="model_olist_ai_product_advice"/><field name="groups" eval="[(4, ref('sales_team.group_sale_manager'))]"/><field name="domain_force">['|', ('owner_id', '=', user.id), ('team_id.user_id', '=', user.id)]</field></record>
    <record id="option_company_rule" model="ir.rule"><field name="name">Phương án: công ty được phép</field><field name="model_id" ref="model_olist_ai_product_option"/><field name="domain_force">[('company_id', 'in', company_ids)]</field></record>
    <record id="option_staff_rule" model="ir.rule"><field name="name">Phương án: người lập</field><field name="model_id" ref="model_olist_ai_product_option"/><field name="groups" eval="[(4, ref('sales_team.group_sale_salesman'))]"/><field name="domain_force">[('owner_id', '=', user.id)]</field></record>
    <record id="option_manager_rule" model="ir.rule"><field name="name">Phương án: quản lý nhóm</field><field name="model_id" ref="model_olist_ai_product_option"/><field name="groups" eval="[(4, ref('sales_team.group_sale_manager'))]"/><field name="domain_force">['|', ('owner_id', '=', user.id), ('team_id.user_id', '=', user.id)]</field></record>
    <record id="risk_decision_company_rule" model="ir.rule"><field name="name">Ghi nhận: công ty được phép</field><field name="model_id" ref="model_olist_ai_quote_risk_decision"/><field name="domain_force">[('company_id', 'in', company_ids)]</field></record>
    <record id="risk_decision_staff_rule" model="ir.rule"><field name="name">Ghi nhận: báo giá của mình</field><field name="model_id" ref="model_olist_ai_quote_risk_decision"/><field name="groups" eval="[(4, ref('sales_team.group_sale_salesman'))]"/><field name="domain_force">[('order_id.user_id', '=', user.id)]</field></record>
    <record id="risk_decision_manager_rule" model="ir.rule"><field name="name">Ghi nhận: nhóm quản lý</field><field name="model_id" ref="model_olist_ai_quote_risk_decision"/><field name="groups" eval="[(4, ref('sales_team.group_sale_manager'))]"/><field name="domain_force">['|', ('order_id.user_id', '=', user.id), ('order_id.team_id.user_id', '=', user.id)]</field></record>
    <record id="risk_company_rule" model="ir.rule"><field name="name">Risk: công ty được phép</field><field name="model_id" ref="model_olist_ai_quote_risk_review"/><field name="domain_force">[('company_id', 'in', company_ids)]</field></record>
    <record id="risk_staff_rule" model="ir.rule"><field name="name">Risk: báo giá của mình</field><field name="model_id" ref="model_olist_ai_quote_risk_review"/><field name="groups" eval="[(4, ref('sales_team.group_sale_salesman'))]"/><field name="domain_force">[('order_id.user_id', '=', user.id)]</field></record>
    <record id="risk_manager_rule" model="ir.rule"><field name="name">Risk: nhóm quản lý</field><field name="model_id" ref="model_olist_ai_quote_risk_review"/><field name="groups" eval="[(4, ref('sales_team.group_sale_manager'))]"/><field name="domain_force">['|', ('order_id.user_id', '=', user.id), ('order_id.team_id.user_id', '=', user.id)]</field></record>
    <record id="review_company_rule" model="ir.rule">
        <field name="name">AI: công ty được phép</field><field name="model_id" ref="model_olist_ai_followup_review"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="review_staff_rule" model="ir.rule">
        <field name="name">AI: việc của mình</field><field name="model_id" ref="model_olist_ai_followup_review"/>
        <field name="groups" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>
        <field name="domain_force">[('order_id.user_id', '=', user.id)]</field>
    </record>
    <record id="review_manager_rule" model="ir.rule">
        <field name="name">AI: nhóm do mình quản lý</field><field name="model_id" ref="model_olist_ai_followup_review"/>
        <field name="groups" eval="[(4, ref('sales_team.group_sale_manager'))]"/>
        <field name="domain_force">['|', ('order_id.user_id', '=', user.id), ('order_id.team_id.user_id', '=', user.id)]</field>
    </record>
</odoo>
