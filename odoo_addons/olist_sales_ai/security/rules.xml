<odoo>
    <record id="review_company_rule" model="ir.rule">
        <field name="name">AI: công ty được phép</field><field name="model_id" ref="model_olist_ai_followup_review"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="review_staff_rule" model="ir.rule">
        <field name="name">AI: việc của mình</field><field name="model_id" ref="model_olist_ai_followup_review"/>
        <field name="groups" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>
        <field name="domain_force">[('order_id.user_id', '=', user.id)]</field>
    </record>
    <record id="review_manager_rule" model="ir.rule">
        <field name="name">AI: nhóm do mình quản lý</field><field name="model_id" ref="model_olist_ai_followup_review"/>
        <field name="groups" eval="[(4, ref('sales_team.group_sale_manager'))]"/>
        <field name="domain_force">['|', ('order_id.user_id', '=', user.id), ('order_id.team_id.user_id', '=', user.id)]</field>
    </record>
</odoo>
